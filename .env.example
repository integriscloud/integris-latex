# Integris LaTeX — local development on latex-dev (TEST VALUES ONLY).
# Copy to .env at the repository root: cp .env.example .env
# Never put production secrets on this server.

NODE_ENV=development

# PostgreSQL (docker/dev.yml, 127.0.0.1:5432)
POSTGRES_USER=integris
POSTGRES_PASSWORD=change-me-dev-postgres
POSTGRES_DB=integris_latex
DATABASE_URL=postgresql://integris:change-me-dev-postgres@127.0.0.1:5432/integris_latex

# Redis (docker/dev.yml, 127.0.0.1:6379). Production uses TLS and ACL users api / worker / collab.
REDIS_PASSWORD=change-me-dev-redis
REDIS_URL=redis://:change-me-dev-redis@127.0.0.1:6379
# ACL user `collab` of the collaboration server (created by docker/dev.yml): may only subscribe
# to the channel collab:events, no access to any key. Same password in both lines.
REDIS_COLLAB_PASSWORD=change-me-dev-redis-collab
COLLAB_REDIS_URL=redis://collab:change-me-dev-redis-collab@127.0.0.1:6379

# MinIO (docker/dev.yml, API 127.0.0.1:9000, console 127.0.0.1:9001).
# Root credentials are for the local console and `pnpm db:seed` only; services get their own
# access keys later.
MINIO_ROOT_USER=integris-dev
MINIO_ROOT_PASSWORD=change-me-dev-minio
# Used by `pnpm db:seed` and the API (default shown).
# MINIO_ENDPOINT=http://127.0.0.1:9000
# Access key of the API, limited to the "projects" (read/write) and "templates" (read) buckets.
# Created in MinIO by `pnpm minio:users` (after `pnpm db:seed` has created the buckets).
MINIO_API_ACCESS_KEY=integris-api
MINIO_API_SECRET_KEY=change-me-dev-minio-api-secret
# Access key of the compilation worker: read/write "compile-output" and "compile-cache" only, no
# right on "projects" (project files reach it as presigned URLs). Created by `pnpm minio:users`.
MINIO_WORKER_ACCESS_KEY=integris-worker
MINIO_WORKER_SECRET_KEY=change-me-dev-minio-worker-secret

# Collaboration server (apps/collab): its calls to the internal API of apps/api (loopback port
# 4200, never proxied by Nginx) carry this shared secret. Same value for both. Generate with:
# openssl rand -base64 48
COLLAB_INTERNAL_SECRET=change-me-dev-collab-internal-secret-at-least-32-characters
# Every collaboration connection is checked again this often (session ended, right lost):
# COLLAB_RECHECK_SECONDS=60   Automatic versions are looked for every HISTORY_SCAN_SECONDS=30

# Where the Next.js server reaches the API (pricing on public pages). Default shown.
# API_INTERNAL_URL=http://127.0.0.1:4000

# Authentication (apps/api). Generate dev secrets with: openssl rand -base64 48
AUTH_SECRET=change-me-dev-auth-secret-at-least-32-characters
ALTCHA_HMAC_KEY=change-me-dev-altcha-key-at-least-32-characters
# Browser origins allowed to call POST endpoints, and base URL of links sent by e-mail.
WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://test-latex.integriscloud.com
PUBLIC_WEB_URL=https://test-latex.integriscloud.com
# `log` writes SMS and e-mails to the API logs (no real message is sent). Refused in production.
SMS_PROVIDER=log
MAIL_PROVIDER=log
# Anti-abuse limits and session lifetimes default to the V1 values (packages/shared/src/env.ts):
# AUTH_ALLOWED_DIAL_CODES=226,225,223,227,228,229,221,33
# OTP_LENGTH=6  OTP_TTL_SECONDS=600  OTP_MAX_ATTEMPTS=5  OTP_RESEND_SECONDS=60
# SEND_LIMIT_PER_ID_15MIN=3  SEND_LIMIT_PER_ID_DAY=10  SEND_LIMIT_PER_IP_HOUR=20  SEND_LIMIT_PER_IP_DAY=100
# AUTH_FAILURE_WINDOW_SECONDS=3600  AUTH_CAPTCHA_AFTER_FAILURES=3  AUTH_LOCK_AFTER_FAILURES=10  AUTH_LOCK_SECONDS=900
# SESSION_IDLE_DAYS=30  SESSION_MAX_DAYS=90  PASSWORD_MIN_LENGTH=10
# AUTH_REAUTH_SECONDS=600  SMS_DAILY_LIMIT=1000 (warning in the logs at 80 %, codes refused at 100 %)
# CAPTCHA difficulty: ALTCHA_KEY_PREFIX=0000 (each extra 0 = 16x more work)  ALTCHA_COST=1
# ZIP import limits (anti ZIP bomb; each extracted file is also limited to 10 MB):
# ZIP_MAX_ARCHIVE_BYTES=52428800 (50 MB)  ZIP_MAX_TOTAL_BYTES=209715200 (200 MB decompressed)
# ZIP_MAX_FILES=2000  ZIP_MAX_RATIO=100 (checked once a file has produced ZIP_RATIO_MIN_BYTES=1048576)
# ZIP_MAX_CONCURRENT_IMPORTS=2 (per API process)  ZIP_IMPORTS_PER_HOUR=20 (per user)  PROJECT_MAX_FILES=2000
# Trash: projects deleted more than 30 days ago are erased every TRASH_PURGE_INTERVAL_MINUTES=60
# Sharing limits, per account and per token first; per address only as a high backstop (CGNAT):
# SHARE_INVITATIONS_PER_DAY=50 (per owner)  INVITATION_ACTIONS_PER_HOUR=30 (accept/decline, per account)
# INVITATION_VIEWS_PER_HOUR_PER_TOKEN=60  INVITATION_VIEWS_PER_HOUR_PER_IP=2000
# PUBLIC_LINK_READS_PER_HOUR_PER_TOKEN=3000  PUBLIC_LINK_READS_PER_HOUR_PER_IP=6000

# Files domain serving compiled PDFs by signed links (API process, port 4100). On latex-dev,
# Nginx proxies https://test-latex-files.integriscloud.com to 127.0.0.1:4100 (default shown is
# for local runs only; it must be a sibling domain of the app, refused otherwise in production).
# FILES_PUBLIC_URL=http://127.0.0.1:4100

# Compilation worker (apps/worker). Image built by `pnpm texlive:build`. Limits are the same for
# every plan (docs/spec.md); the duration comes from the plan. Defaults shown:
# SANDBOX_IMAGE=integris/texlive:2026  SANDBOX_RUNTIME=runsc  COMPILE_CONCURRENCY=2
# COMPILE_CPUS=2  COMPILE_MEMORY_MB=2048  COMPILE_PIDS=128  COMPILE_WORKDIR_MB=1024
# COMPILE_TMP_MB=256  COMPILE_MAX_PDF_MB=200
